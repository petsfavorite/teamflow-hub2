{
  "name": "Monthly Call Records Cleanup",
  "description": "Daily cleanup of call records older than 60 days from the dashboard.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "cron_expression": "15 10 * * *",
      "schedule_mode": "recurring",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null,
      "events": []
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_call_records_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupOldCallRecords",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "cleanupOldCallRecords"
  }
}