{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "archive_call_recordings",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveCallRecordings",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Downloads new call recordings from Zoom into the 'Zoom Call Recordings' Google Drive folder and permanently deletes recordings older than 90 days.",
  "name": "Archive Call Recordings to Drive",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-09-30T12:08:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}