{
  "name": "Zoom Direct Pull - Backup Sync",
  "description": "Backup call sync that pulls directly from Zoom Phone API (bypassing Google Sheet). Deduplicates against existing records. Ensures calls keep flowing even if the Sheet sync breaks.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-09-29T18:30:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "zoom_direct_pull_backup_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backfillZoomCalls",
            "args": {
              "batch_size": 5
            }
          },
          "then": "end"
        }
      }
    ]
  }
}