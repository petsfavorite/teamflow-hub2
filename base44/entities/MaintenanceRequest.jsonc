{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "asset_id": {
      "type": "string",
      "description": "Linked asset if applicable"
    },
    "asset_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "working_on",
        "waiting_on",
        "completed"
      ],
      "default": "received"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Primary assignee email (first in assigned_to_emails, kept for backward compat)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Display name of the primary assignee (backward compat)"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of all users assigned to this request"
    },
    "assigned_to_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of all assigned users"
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "acknowledged_at": {
            "type": "string"
          }
        }
      },
      "description": "Users who have acknowledged this request and when"
    },
    "notes_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "added_by": {
            "type": "string",
            "description": "Email of person who added the note"
          },
          "added_by_name": {
            "type": "string"
          },
          "attachment_url": {
            "type": "string",
            "description": "Optional attachment URL"
          }
        }
      },
      "description": "Log of notes with metadata"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}