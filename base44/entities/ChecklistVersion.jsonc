{
  "name": "ChecklistVersion",
  "type": "object",
  "properties": {
    "checklist_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "change_summary": {
      "type": "string",
      "description": "What changed in this version"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "checklist_id",
    "version_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}