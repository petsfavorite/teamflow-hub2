{
  "name": "CallRecord",
  "type": "object",
  "properties": {
    "zoom_meeting_id": {
      "type": "string",
      "description": "Zoom call ID or sheet row identifier (e.g. sheet_row_5)"
    },
    "call_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the call occurred"
    },
    "call_duration_seconds": {
      "type": "number",
      "description": "Duration in seconds"
    },
    "call_direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "caller_phone": {
      "type": "string"
    },
    "caller_name": {
      "type": "string"
    },
    "team_member": {
      "type": "string",
      "description": "Full name of the app user who handled the call"
    },
    "transcript": {
      "type": "string"
    },
    "transcript_summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "recording_url": {
      "type": "string",
      "description": "Link to the call audio recording"
    },
    "caller_type": {
      "type": "string",
      "enum": [
        "potential_client",
        "returning_client",
        "not_applicable"
      ]
    },
    "caller_intent": {
      "type": "string"
    },
    "bookable": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ]
    },
    "booking_outcome": {
      "type": "string",
      "enum": [
        "appt_booked",
        "appt_not_booked",
        "appt_not_needed"
      ]
    },
    "was_booked": {
      "type": "boolean"
    },
    "booked_date": {
      "type": "string",
      "format": "date-time"
    },
    "booking_offered": {
      "type": "boolean",
      "description": "True if staff offered an appointment but the caller did not commit (for missed bookings only)"
    },
    "missed_call": {
      "type": "boolean",
      "default": false,
      "description": "True if no one at the clinic answered this call"
    },
    "clinic_closed": {
      "type": "boolean",
      "default": false,
      "description": "True if the clinic was closed when this missed call occurred (holiday, weather closure, etc.) \u2014 excluded from 'Missed Calls when Open' metric"
    },
    "ai_notes": {
      "type": "string"
    },
    "ai_enriched": {
      "type": "boolean",
      "default": false,
      "description": "True once AI transcript analysis has been run on this record"
    },
    "zoom_recording_id": {
      "type": "string",
      "description": "Zoom Phone recording ID, used to download the audio into Google Drive."
    },
    "recording_drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID of the archived recording. Set once the audio has been saved to Drive."
    },
    "recording_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of failed attempts to save this recording to Drive."
    },
    "enrich_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of failed AI enrichment attempts. After too many failures the record is flagged and skipped so it cannot block the queue."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "reviewed",
        "flagged"
      ],
      "default": "pending_review"
    }
  },
  "required": [
    "call_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}