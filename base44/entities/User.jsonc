{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "manager",
        "user",
        "general_account"
      ],
      "default": "user",
      "description": "User role"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Team IDs this user is assigned to",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      }
    },
    "timezone": {
      "type": "string",
      "description": "User's timezone"
    },
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "last_name": {
      "type": "string",
      "description": "User's last name"
    },
    "pin": {
      "type": "string",
      "description": "6-digit numeric PIN",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "pin_failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed PIN attempt counter (persisted for cross-isolate lockout)",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "pin_locked_until": {
      "type": "string",
      "description": "ISO timestamp until which the PIN is locked due to too many failed attempts",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "session_locked_at": {
      "type": "string",
      "description": "ISO timestamp of inactivity PIN lock \u2014 checked server-side so clearing browser storage can't bypass the lock. Cleared only by validatePin on correct PIN entry.",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "invited": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user was invited (not self-registered)"
    },
    "initials": {
      "type": "string",
      "description": "User's initials with version number (e.g., 'JD1', 'JD2')"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is archived \u2014 archived users cannot log in"
    }
  },
  "required": [
    "team_ids",
    "timezone"
  ]
}