{
  "name": "RecurringChecklist",
  "type": "object",
  "properties": {
    "template_title": {
      "type": "string",
      "description": "Title of the checklist (copied from template at creation time)"
    },
    "template_description": {
      "type": "string"
    },
    "template_category": {
      "type": "string"
    },
    "template_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "sop_id": {
            "type": "string"
          }
        }
      },
      "description": "Checklist items copied from template at assignment time"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_to_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_teams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_time": {
      "type": "string",
      "description": "Time in HH:MM format \u2014 when the checklist is due"
    },
    "visible_time": {
      "type": "string",
      "description": "Time in HH:MM format \u2014 when the checklist becomes visible to assignees on the due date"
    },
    "visible_day_offset": {
      "type": "integer",
      "default": 0,
      "description": "How many days before the due date the checklist should become visible (0 = same day, 1 = day before, etc.). Used for weekly/monthly recurrence."
    },
    "recurrence_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekdays",
        "specific_days",
        "monthly",
        "every_x_months",
        "annually",
        "manual"
      ]
    },
    "recurrence_days_of_week": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "recurrence_day_of_month": {
      "type": "integer"
    },
    "recurrence_interval_months": {
      "type": "integer"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "When false, no new instances will be spawned"
    }
  },
  "required": [
    "template_title",
    "recurrence_type"
  ]
}