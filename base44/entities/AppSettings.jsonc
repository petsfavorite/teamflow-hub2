{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting identifier (use 'global' for app-wide settings)"
    },
    "inactivity_timeout_minutes": {
      "type": "number",
      "default": 5,
      "description": "Minutes of inactivity before PIN lock screen appears"
    },
    "global_timezone": {
      "type": "string",
      "default": "America/New_York",
      "description": "Global timezone for all users in the app"
    },
    "call_dashboard_options": {
      "type": "object",
      "description": "Configurable options for the Call Dashboard dropdowns and AI prompts",
      "properties": {
        "caller_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "booking_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "call_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "ai_caller_type_prompt": {
          "type": "string",
          "description": "Instructions for the AI on how to classify caller type (returning client, potential client, NA, or missed call)"
        },
        "ai_booking_prompt": {
          "type": "string",
          "description": "Instructions for the AI on how to classify booking outcomes (booked, not bookable, missed booking)"
        },
        "ai_booking_offered_prompt": {
          "type": "string",
          "description": "Instructions for the AI on how to determine if a booking was offered for missed bookings"
        },
        "name_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alias": {
                "type": "string",
                "description": "Name as it appears in transcripts"
              },
              "full_name": {
                "type": "string",
                "description": "Canonical user full name to match to"
              }
            }
          },
          "description": "Name aliases to help match names from transcripts to users"
        },
        "ai_booking_criteria": {
          "type": "string",
          "description": "Legacy field \u2014 superseded by ai_booking_prompt"
        }
      }
    },
    "last_synced_sheet_row": {
      "type": "number",
      "description": "The last Google Sheet row number that was successfully processed by scheduledSheetSync. Used as a high-water mark to avoid re-scanning all rows on every run."
    },
    "last_synced_call_date": {
      "type": "string",
      "description": "ISO timestamp of the most recent call_date seen in the sheet. Used as a high-water mark so the sync only processes rows newer than this, reducing the dedup query size."
    },
    "last_call_log_error_email_at": {
      "type": "string",
      "description": "ISO timestamp of the last call log error email sent. Used to throttle error emails to once per hour."
    }
  },
  "required": [
    "key"
  ]
}