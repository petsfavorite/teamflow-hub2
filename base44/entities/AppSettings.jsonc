{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting identifier (use 'global' for app-wide settings)"
    },
    "inactivity_timeout_minutes": {
      "type": "number",
      "default": 5,
      "description": "Minutes of inactivity before PIN lock screen appears"
    },
    "global_timezone": {
      "type": "string",
      "default": "America/New_York",
      "description": "Global timezone for all users in the app"
    },
    "call_dashboard_options": {
      "type": "object",
      "description": "Configurable options for the Call Dashboard dropdowns",
      "properties": {
        "caller_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "description": "Options for the Caller Type field"
        },
        "booking_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "description": "Options for the Booking Outcome field"
        },
        "call_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "description": "Options for the Call Status field"
        }
      }
    }
  },
  "required": [
    "key"
  ]
}