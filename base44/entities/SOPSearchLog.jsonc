{
  "name": "SOPSearchLog",
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "answered": {
      "type": "boolean",
      "description": "False when the SOP Assistant could not find a procedure that covers the question"
    },
    "matched_sop_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
