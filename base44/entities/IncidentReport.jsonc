{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "interpersonal",
        "pet_issue",
        "osha_reportable",
        "other"
      ],
      "description": "High-level category of the incident"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "incident_time": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "If true, only admins and super_admins can view"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "resolved"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "description": "Primary assignee email (first in assigned_to_emails, kept for backward compat)"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of all users assigned to this report"
    },
    "assigned_to_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of all assigned users"
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "acknowledged_at": {
            "type": "string"
          }
        }
      },
      "description": "Users who have acknowledged this incident and when"
    },
    "notes_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "added_by": {
            "type": "string"
          },
          "added_by_name": {
            "type": "string"
          },
          "attachment_url": {
            "type": "string"
          }
        }
      }
    },
    "osha_employee_name": {
      "type": "string"
    },
    "osha_job_title": {
      "type": "string"
    },
    "osha_date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "osha_date_hired": {
      "type": "string",
      "format": "date"
    },
    "osha_sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ]
    },
    "osha_time_of_incident": {
      "type": "string"
    },
    "osha_what_was_employee_doing": {
      "type": "string"
    },
    "osha_what_happened": {
      "type": "string"
    },
    "osha_injury_or_illness": {
      "type": "string",
      "description": "Body part affected / nature of injury"
    },
    "osha_object_or_substance": {
      "type": "string",
      "description": "Object or substance that directly harmed employee"
    },
    "osha_not_sure_about_care": {
      "type": "boolean",
      "default": false,
      "description": "If true, care/treatment details are unknown at time of filing"
    },
    "osha_medical_treatment": {
      "type": "string",
      "enum": [
        "none",
        "first_aid_only",
        "physician_or_er",
        "hospitalized"
      ]
    },
    "osha_days_away_from_work": {
      "type": "number"
    },
    "osha_days_on_restricted_duty": {
      "type": "number"
    },
    "osha_physician_name": {
      "type": "string"
    },
    "osha_treatment_facility": {
      "type": "string"
    },
    "osha_treatment_facility_address": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reported_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reported_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reported_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reported_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}